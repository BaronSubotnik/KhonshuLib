    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Khonshu</Title>
    <Authors>Darkhold</Authors>
    <Description>Хонсу хочет делать запросы к нейросетям и шифроватся</Description>
    <PackageIcon>Cavaleiro Khonshu.jpg</PackageIcon>
